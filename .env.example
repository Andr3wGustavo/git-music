# ==============================================================================
# Git-Music Environment Configuration Template
# Copy this file to .env and fill in your production credentials
# ==============================================================================

# Local Daemon Configuration
GIT_MUSIC_PORT=4848
GIT_MUSIC_ENV=development
PROJECT_ROOT=.

# Cloudflare R2 / AWS S3 Storage (Zero-Egress Audio Chunks)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=git-music-audio-chunks
R2_PUBLIC_DOMAIN=https://chunks.git-music.io

# Global Cloud Relay Server
RELAY_SERVER_URL=wss://relay.git-music.io
RELAY_PORT=8080

# Database (Supabase / Neon Postgres for Multi-User Teams)
DATABASE_URL=postgresql://postgres:password@localhost:5432/gitmusic
